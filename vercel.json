{
  "version": 2,
  "buildCommand": "node scripts/generate_manifest.mjs",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/PDF/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    },
    {
      "source": "/HTML/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/HTML/(.*)$",
      "dest": "/HTML/$1"
    },
    {
      "src": "^/PDF/(.*)$",
      "dest": "/PDF/$1"
    },
    {
      "src": "^/data/(.*)$",
      "dest": "/dashboard/public/data/$1"
    },
    {
      "src": "^/api/resumes$",
      "dest": "/dashboard/public/data/resumes.json"
    },
    {
      "src": "^/(.*)\\.(css|js|png|svg|ico|json)$",
      "dest": "/dashboard/public/$1.$2"
    },
    {
      "src": "^/.*$",
      "dest": "/dashboard/public/index.html"
    }
  ]
}
