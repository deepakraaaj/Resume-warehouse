{
  "version": 2,
  "buildCommand": "node scripts/build.mjs",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/PDF/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ],
  "routes": [
    { "src": "^/(HTML|PDF|data)/(.*)$", "dest": "/$1/$2" },
    { "src": "^/(app\\.js|rules\\.js|style\\.css)$", "dest": "/dashboard/public/$1" },
    { "src": "^/.*$", "dest": "/dashboard/public/index.html" }
  ]
}
