{
  "buildCommand": "npm ci --prefix hunt && npm run build --prefix hunt && node scripts/build.mjs --site",
  "outputDirectory": "public",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/app.js": {
      "maxDuration": 60,
      "includeFiles": "fonts/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/app?route=:route*"
    },
    {
      "source": "/HTML/:file",
      "destination": "/api/app?route=html&file=:file"
    },
    {
      "source": "/PDF/:file",
      "destination": "/api/app?route=pdf&name=:file"
    },
    {
      "source": "/hunt/:path*",
      "destination": "/hunt/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/hunt.html",
      "destination": "/hunt/",
      "permanent": false
    },
    {
      "source": "/hunt",
      "destination": "/hunt/",
      "permanent": false
    }
  ]
}
